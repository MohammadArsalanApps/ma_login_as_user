<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="rule_impersonation_log_company" model="ir.rule">
        <field name="name">Impersonation log: allowed companies</field>
        <field name="model_id" ref="model_ma_impersonation_log"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_impersonation_manager')), (4, ref('group_impersonation_auditor'))]"/>
    </record>
    <record id="rule_impersonation_action_company" model="ir.rule">
        <field name="name">Impersonation action: allowed companies</field>
        <field name="model_id" ref="model_ma_impersonation_action"/>
        <field name="domain_force">[('log_id.company_id', 'in', company_ids)]</field>
        <field name="groups" eval="[(4, ref('group_impersonation_manager')), (4, ref('group_impersonation_auditor'))]"/>
    </record>
</odoo>
