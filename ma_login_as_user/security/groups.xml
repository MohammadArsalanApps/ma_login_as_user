<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_login_as" model="res.groups.privilege">
        <field name="name">Login as Any User</field>
        <field name="category_id" ref="base.module_category_administration"/>
    </record>
    <record id="group_impersonation_manager" model="res.groups">
        <field name="name">Impersonation Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_login_as"/>
        <field name="comment">May switch into eligible user accounts. Every session is audited.</field>
    </record>
    <record id="group_impersonation_auditor" model="res.groups">
        <field name="name">Impersonation Auditor</field>
        <field name="privilege_id" ref="res_groups_privilege_login_as"/>
        <field name="comment">Read-only access to user impersonation audit records.</field>
    </record>
</odoo>
